# Logs
logs/
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment and secrets
**/.env
**/.env.*
!**/.env.example
.env.local
.env.*.local
*.local

# Deployment and CLI temp files
.vercel/
**/.vercel/
.vercel
supabase/.temp/
