# Workspace-wide ignore rules for syncing this project across laptops.
# Keep shared source, BMAD artifacts, and GitHub config tracked; exclude local state.

# Dependencies and build outputs
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
coverage/
**/coverage/
playwright-report/
**/playwright-report/
test-results/
**/test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment and secrets
**/.env
**/.env.*
!**/.env.example

# Deployment and CLI temp files
.vercel/
**/.vercel/
**/supabase/.temp/

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vs/
.vscode/*
!.vscode/mcp.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

