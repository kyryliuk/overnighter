# ============================================================
# Overnighter — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
# ============================================================

# ── Supabase (Public — safe to expose to browser) ──────────
# These are prefixed VITE_ and embedded in the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (Server-only — NEVER prefix with VITE_) ───────
# Only used in api/*.ts serverless functions. Never imported from src/.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin Bearer Token (Server-only) ───────────────────────
# Protects all admin API endpoints. Store in Vercel + GitHub secrets.
ADMIN_SECRET=

# ── Data Pipeline (Server-only) ────────────────────────────
# Full URL to POST /api/sync endpoint. Used by GitHub Actions cron.
SYNC_URL=

# ── Sentry Error Tracking (Public DSN — safe to expose) ───
VITE_SENTRY_DSN=

# ── Stripe (Server-only — NEVER prefix with VITE_) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ANNUAL=

# ── Stripe (Public — safe to expose to browser) ───────────
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Web Push / VAPID (split server/public) ─────────────────
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
