# ============================================================
# Overnighter — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
# ============================================================


# === App (Vite build-time) ===
# These VITE_* variables are embedded into the browser bundle at build time.
# They are PUBLIC — do not put secrets here.

# Canonical site URL — used in magic-link and password-reset email redirects.
# Set to your production domain; for local dev use http://localhost:5173
VITE_SITE_URL=https://overnighter.net


# === Supabase ===
# Dashboard → Project Settings → API

# Public URL for your Supabase project (safe to expose to browser)
VITE_SUPABASE_URL=

# Public anonymous key — used in the browser client (safe to expose)
VITE_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses Row Level Security.
# NEVER prefix with VITE_. Only used in api/*.ts serverless functions.
SUPABASE_SERVICE_ROLE_KEY=


# === Stripe ===
# Dashboard → Developers → API keys  |  Webhooks → Signing secret

# Server-side secret key — NEVER expose to the browser.
# Use sk_test_... for development, sk_live_... for production.
STRIPE_SECRET_KEY=

# Signing secret for verifying webhook payloads from Stripe.
# Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# Price ID for the annual subscription plan.
# Dashboard → Products → select plan → copy Price ID (price_...)
STRIPE_PRICE_ID_ANNUAL=

# Publishable key — embedded in the browser bundle (safe to expose).
# Use pk_test_... for development, pk_live_... for production.
VITE_STRIPE_PUBLISHABLE_KEY=


# === Sentry ===
# sentry.io → Your project → Settings → Client Keys (DSN)

# Public DSN — safe to expose to the browser. Leave blank to disable Sentry.
VITE_SENTRY_DSN=


# === Push Notifications (VAPID) ===
# Generate a VAPID key pair once with: npx web-push generate-vapid-keys

# Public VAPID key — embedded in the browser bundle and sent with subscriptions.
VITE_VAPID_PUBLIC_KEY=

# Private VAPID key — server-only. Never expose to the browser.
VAPID_PRIVATE_KEY=

# VAPID subject — contact email or URL for the push service to reach you.
VAPID_SUBJECT=mailto:admin@overnighter.net

# Internal token used by the /api/push/send endpoint to authenticate push
# notification dispatch calls from _pushNotify.ts and _submissionNotify.ts.
# Generate with: openssl rand -hex 32
PUSH_ADMIN_TOKEN=


# === Admin ===
# Protects all admin-only API endpoints via Bearer token auth (_middleware.ts).
# Must also be set as a GitHub Actions secret (used by the sync-gov workflow).
# Generate with: openssl rand -hex 32
ADMIN_SECRET=


# === Sync (Government Data) ===
# Used by the GitHub Actions daily cron (sync-gov.yml) to trigger pin data sync.

# Full URL of the deployed /api/sync-gov endpoint.
# e.g. https://overnighter.net/api/sync-gov
SYNC_URL=

# API key for the Recreation Information Database (RIDB) — BLM/USFS/NPS data.
# Register at: https://ridb.recreation.gov/apilogin
RIDB_API_KEY=


# === AWS (for SageMaker inference) ===
# Required only if using the AI recommendation or ML inference features.
# IAM user should have minimal permissions (e.g. sagemaker:InvokeEndpoint only).

# AWS region where your SageMaker endpoint is deployed (e.g. us-west-2)
AWS_REGION=

# IAM access key ID for SageMaker API calls — server-only.
AWS_ACCESS_KEY_ID=

# IAM secret access key — server-only. NEVER expose to the browser.
AWS_SECRET_ACCESS_KEY=


# === SageMaker ===
# Required only if the ML inference / campsite recommendation feature is active.

# Name of the deployed SageMaker endpoint (as shown in the AWS console).
SAGEMAKER_ENDPOINT_NAME=


# === Docker / Local Dev ===
# Only needed when running local services via docker-compose.

# Auto-injected by Vercel in deployed environments; used to build internal
# API call URLs (e.g. for push notification dispatch). Leave blank locally —
# the code falls back to a relative URL.
VERCEL_URL=
